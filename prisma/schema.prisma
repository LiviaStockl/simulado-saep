// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Eventos {
  id   Int    @id @default(autoincrement())
  nome String
  local String
  descricao String
  palestrantes Palestrante @relation(fields: [palestranteId], references: [id])
  palestranteId Int
}

model Palestrante {
  id   Int    @id @default(autoincrement())
  nome String
  email String @unique
  eventos Eventos[]
}
